# =============================================================================
# Fast Delivery - AWS EC2 & RDS Configuration
# =============================================================================
# Copia este archivo como .env en tu servidor EC2 y configura tus credenciales de RDS

# Endpoint de tu instancia AWS RDS MySQL (ej: delivery-db.xxxxxx.us-east-1.rds.amazonaws.com)
DB_HOST=127.0.0.1
DB_PORT=3306

# Nombre de la base de datos creada en RDS
DB_NAME=delivery_db

# Usuario maestro o de aplicación configurado en AWS RDS
DB_USER=root

# Contraseña de la base de datos RDS
DB_PASS=

# Charset recomendado para soporte completo UTF-8
DB_CHARSET=utf8mb4
